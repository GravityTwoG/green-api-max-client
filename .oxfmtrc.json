{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "shared",
        "elementNamePattern": ["@/shared/**"]
      },
      {
        "groupName": "pages",
        "elementNamePattern": ["@/pages/**"]
      },
      {
        "groupName": "app",
        "elementNamePattern": ["@/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "shared",
      "pages",
      "app",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "arrowParens": "always",
  "insertFinalNewline": true,
  "endOfLine": "lf"
}
