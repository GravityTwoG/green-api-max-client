{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "sortImports": {
    "groups": ["builtin", "external", ["parent", "sibling", "index"], "style", "unknown"],
    "newlinesBetween": true
  },
  "arrowParens": "always",
  "insertFinalNewline": true,
  "endOfLine": "lf"
}
